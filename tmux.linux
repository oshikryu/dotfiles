# keybindings
unbind C-b
# bind ctrl + b for linux nested terminal
# set -g prefix C-a
# bind C-a send-prefix

# window splits
bind | split-window -h
bind - split-window -v

# only
bind o kill-pane -a

# repeat timing
set -g repeat-time 200

# pane movement
# bind -r h select-pane -L
# bind -r j select-pane -D
# bind -r k select-pane -U
# bind -r l select-pane -R
# 
# bind -r H resize-pane -L 5
# bind -r J resize-pane -D 5
# bind -r K resize-pane -U 5
# bind -r L resize-pane -R 5

bind < rotate-window -D
bind > rotate-window -U
bind / next-layout


# colors
set -g default-terminal "tmux-256color"

set -g status-fg white
set -g status-bg colour235

set-window-option -g window-status-style fg=blue
set-window-option -g window-status-style bg=default
set-window-option -g window-status-style dim

set-window-option -g window-status-current-style fg=red
set-window-option -g window-status-current-style bg=default
set-window-option -g window-status-current-style bright

# Claude Code state glyph per window (set by ~/.claude/hooks/tmux/state.sh):
# cyan * = working, yellow ! = waiting on you, nothing = idle/not a Claude pane.
set -g window-status-format "#I:#W#{?#{==:#{@claude_state},working}, #[fg=cyan]*#[default],}#{?#{==:#{@claude_state},waiting}, #[fg=yellow]!#[default],}"
set -g window-status-current-format "#I:#W#{?#{==:#{@claude_state},working}, #[fg=cyan]*#[default],}#{?#{==:#{@claude_state},waiting}, #[fg=yellow]!#[default],}"

setw -g window-status-activity-style none
setw -g window-status-bell-style fg=black,bg=red
set -g monitor-bell on
set -g bell-action any
set -g visual-bell off
set -g pane-border-style fg=white,bg=default
set -g pane-active-border-style fg=white,bg=default
set -g window-style fg=colour240,bg=colour234
set -g window-active-style fg=white,bg=default
set -g message-style fg=white,bg=black,bright

# status lines
set -g status-left-length 60
set -g status-left "#[fg=green,bold][#S] #[fg=white]#W"

set -g @aws_profile ""

set -g status-right-length 160
set -g status-right "#{?client_prefix,#[bg=red fg=white bold] PRE #[default] ,}#[fg=magenta]CPU:#(top -bn2 -d0.1 | grep '%Cpu' | tail -1 | awk '{print int(\$2) \"%\"}') #[fg=blue]MEM:#(free -m | awk '/Mem/{print int(\$3/\$2*100) \"%\"}') #{?@aws_profile,#[fg=colour214]aws:#{@aws_profile} ,}#[fg=yellow]#(git -C #{pane_current_path} branch --show-current 2>/dev/null)#(git -C #{pane_current_path} status --porcelain 2>/dev/null | grep -q . && echo '*') #[fg=white]| #[fg=cyan]%d %b %H:%M"


# other settings
set -sg escape-time 1

# allow OSC escape sequences (e.g. Claude Code desktop alerts) through tmux
set -g allow-passthrough on

set -g base-index 1
setw -g pane-base-index 1

setw -g monitor-activity on
set -g visual-activity on

set -g status-justify centre
setw -g mode-keys vi
set -g status-interval 20

unbind Down
bind Up resize-pane -Z
bind Down resize-pane -Z

# scrollback buffer
set-option -g history-limit 100000
